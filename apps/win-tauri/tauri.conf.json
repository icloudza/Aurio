{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurio",
  "version": "0.2.6",
  "identifier": "com.aurio.win",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aurio",
        "width": 440,
        "height": 680,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png"
    ]
  }
}